generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RESIDENT
  BUSINESS
  YOUTH
  ADMIN
}

enum RequestStatus {
  NEW
  CLAIMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  role          Role      @default(RESIDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  requests      ServiceRequest[] @relation("ResidentRequests")
  claimed       ServiceRequest[] @relation("ClaimedBy")
  rsvps         RSVP[]
}

model ServiceRequest {
  id          String        @id @default(cuid())
  type        String
  description String
  address     String
  status      RequestStatus @default(NEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  residentId  String
  resident    User          @relation("ResidentRequests", fields: [residentId], references: [id])
  claimedById String?
  claimedBy   User?         @relation("ClaimedBy", fields: [claimedById], references: [id])
}

model Event {
  id             String   @id @default(cuid())
  title          String
  description    String
  location       String
  startsAt       DateTime
  createdAt      DateTime @default(now())
  organizerId    String
  organizer      User     @relation(fields: [organizerId], references: [id])
  rsvps          RSVP[]
  proofImageUrl  String?
}

model RSVP {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
